{
  "name": "who-said-dis",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/cli"
  ],
  "scripts": {
    "test": "node --test",
    "cli": "node ./apps/cli/bin/who-said-dis.js",
    "server": "node --env-file-if-exists=.env ./apps/server/src/index.js",
    "dev": "node --env-file-if-exists=.env --watch ./apps/server/src/index.js",
    "scenario:visual": "node ./apps/server/src/visual-scenario.js",
    "pack:cli": "npm pack --workspace @xz3dev/who-said-dis --dry-run",
    "publish:cli": "npm publish --workspace @xz3dev/who-said-dis"
  },
  "dependencies": {
    "posthog-js": "1.417.1",
    "reconnecting-websocket": "4.4.0",
    "ws": "8.21.3"
  }
}

PUBLIC_URL=http://localhost:3000
# Docker Compose host binding. Keep loopback-only when a local reverse proxy fronts the app.
BIND_ADDRESS=127.0.0.1
PORT=3000
DATABASE_PATH=./data/who-said-dis.sqlite
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=localhost
SECURE_COOKIES=0
TRUST_PROXY=0
# Required when TRUST_PROXY=1. List only direct reverse-proxy peer addresses; the proxy must append
# or replace X-Forwarded-For rather than passing an untrusted client value through unchanged.
TRUSTED_PROXY_IPS=
VOTE_TIMEOUT_SECONDS=45
# Optional public PostHog project key. Analytics remain disabled when empty.
POSTHOG_PUBLIC_KEY=
# Required in production for the imprint and privacy notice.
LEGAL_NAME=Felix Mennen
LEGAL_ADDRESS=Ostlandring 63, 31303 Burgdorf, Germany
LEGAL_EMAIL=felix@xz3.dev
# Add these when applicable to the operator.
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER=
LEGAL_REGISTRATION_NUMBER=
# Optional override for the command displayed in the room lobby.
# CLI_COMMAND=npm run cli --
# Local development only. Never enable in production.
# TURNSTILE_BYPASS=1
